# ============================================================
# Fillando — Master Environment Template
# ============================================================
# Copy this file to /.env in the meta-repo root, fill in real
# values, then run `bash scripts/sync-env.sh` to distribute
# to child repos.
#
# NEVER commit .env files with real secrets.
# ============================================================

# === BEGIN COMMON ===
NODE_ENV=development
# Shared secret that lets the frontend's server-side fetches bypass the backend
# rate limiter (sent as `X-Internal-Token`). Optional; when unset, nothing is
# exempted. The frontend does not send it yet, so leave it unset.
# WARNING: never leave the line as `INTERNAL_API_TOKEN=` with an empty value —
# the backend validates it as min 32 chars and refuses to boot. Either keep it
# commented out or set a real value: openssl rand -hex 32
# INTERNAL_API_TOKEN=
# Shared secret for the storefront's POST /api/revalidate: the backend sends it as
# `x-revalidate-secret` after landing writes, the frontend compares it and purges its
# cached landing copy. The SAME value goes to both services — that is why it sits in
# COMMON. Not needed in development (the frontend accepts the call without it outside
# production); required in production, ≥32 chars: openssl rand -hex 32.
# Never NEXT_PUBLIC_*, never a Docker build arg — a runtime variable on both sides.
# REVALIDATE_SECRET=
# === END COMMON ===

# === BEGIN BACKEND ===

# --- App ---
PORT=4000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:9000
# Publicly reachable base URL of the backend, used to build the LiqPay
# `server_url` callback. Local: http://localhost:4000 ; prod: https://api.fillando.com
PUBLIC_API_URL=http://localhost:4000

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://fillando_user:fillando_pass@localhost:27017/fillando_dev?authSource=admin

# --- JWT ---
JWT_SECRET=CHANGE_ME_min_10_chars
JWT_EXPIRATION=15
ACCSESS_TOKEN_NAME=access_token

REFRESH_JWT_SECRET=CHANGE_ME_min_10_chars_different
REFRESH_JWT_EXPIRATION=10080
REFRESH_TOKEN_NAME=refresh_token

# --- Password ---
PASSWORD_PEPPER=CHANGE_ME_min_16_chars_random

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- AWS S3 ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=fillando-uploads
AWS_S3_PUBLIC_URL=https://fillando-uploads.s3.eu-central-1.amazonaws.com

# --- Nova Post ---
NOVA_POS_API_KEY=your-nova-post-api-key

# --- Prom.ua (supplier price/availability sync) ---
PROM_API_KEY=your-prom-api-key

# --- Cron ---
# Enables in-process scheduled jobs (Prom availability sync). `true` on exactly
# one instance; anything else is off.
RUN_CRON=false

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
SERVICE_EMAIL=fillandostore@gmail.com
ALLOW_EMAIL_SENDING=false

# --- Payments ---
# Secret used to derive the AES-256-GCM key that encrypts payment provider
# (LiqPay/MonoPay) private keys at rest. Min 32 chars, high entropy.
# Generate: `openssl rand -hex 32`. Back this up — losing it makes stored
# provider secrets unrecoverable. LiqPay merchant keys themselves are entered
# in the admin panel (/admin/payment-details/liqpay), not here.
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_min_32_chars_random

# === END BACKEND ===

# === BEGIN FRONTEND ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# NOTE: the three vars below are only read at BUILD time (all NEXT_PUBLIC_* are
# inlined into the bundle). On production they must be passed as Docker build args
# via docker-compose.prod.yml — setting them in .env.prod has no effect, silently.
# They are listed here for local dev, where `yarn dev` reads .env directly.
#
# All three have safe in-code defaults, so leaving them unset is fine.

# Route images through the S3 width derivatives (custom next/image loader).
# Leave false until the backend's generate-image-derivatives.js migration has been
# run and its MODE='verify' pass exits 0 — a missing derivative is a hard 404 with
# no fallback.
NEXT_PUBLIC_USE_IMAGE_DERIVATIVES=false

# Google Ads. Override on staging so it cannot pollute production conversions.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18332229942
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=AW-18332229942/vho6CLCit9McELbCvqVE

# GA4 property (Performance Max signals) and Search Console verification token
# (TD-0006 §5.5/§5.6). Both are inert while empty — no config line, no meta tag.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# === END FRONTEND ===
